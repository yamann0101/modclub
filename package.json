{
  "name": "mod-club",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "setup": "node setup.mjs",
    "dev": "pnpm --filter @workspace/mod-club run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "build": "pnpm --filter @workspace/mod-club run build && pnpm --filter @workspace/api-server run build",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
