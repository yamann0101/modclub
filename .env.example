# Railway Postgres bağlayınca DATABASE_URL otomatik gelir. Elle doldurma.
# PORT Railway verir. Yoksa 8080 kullanılır.
PORT=8080
HOST=0.0.0.0
DATABASE_URL=

# Pragmatic Play resmi operator entegrasyonu. Bu değerler PP hesabından gelir.
# Oyun dosyası barındırılmaz. Secret frontend'e gitmez.
# Yoksa sahte API kurulmaz; launch 503 döner ve eksik alanları listeler.
PP_SECURE_LOGIN=
PP_SECRET_KEY=
PP_API_URL=
PP_LAUNCH_URL=
PP_CURRENCY=
PP_LANGUAGE=tr
PP_PLATFORM=WEB
PP_TECHNOLOGY=H5
PP_AMOUNT_SCALE=1
